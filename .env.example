# Copy this file to packages/server/.env and fill in as needed.
# The app runs fully in SIMULATION MODE with none of these set.

# ------------------------------------------------------------------
# Core
# ------------------------------------------------------------------
# Port the API server listens on (the web dev server proxies /api to it).
PORT=4000

# 32+ character secret used to encrypt the Teller access token at rest.
# If left blank, a random key is generated once and stored in packages/server/.secret
APP_SECRET=

# ------------------------------------------------------------------
# Teller (only needed for LIVE mode — set up from the app's Settings page)
# ------------------------------------------------------------------
# From https://teller.io dashboard. Looks like: app_xxxxxxxxxxxxx
TELLER_APPLICATION_ID=

# sandbox | development | production
TELLER_ENVIRONMENT=sandbox

# mTLS client certificate — REQUIRED by Teller for ALL server-side API calls,
# including sandbox. Download the certificate + private key from the Teller
# dashboard (Application -> Certificates) and point these at the .pem files.
TELLER_CERT_PATH=./certs/certificate.pem
TELLER_KEY_PATH=./certs/private_key.pem
